# Definicion declarativa de la red
# GENERADO. No editar a mano (ADR-006).
#
# Cliente : {{ cliente.nombre }} ({{ cliente.id }})
# Paquete : {{ paquete }}
# Octeto  : {{ red.octeto }}
# Generado: {{ generado_en }}
#
# Se aplica el MISMO estandar de direccionamiento en cada instalacion, para que cualquier tecnico
# pueda moverse por cualquier sitio sin leer antes la documentacion.
#
# El SEGUNDO OCTETO se asigna por cliente desde el registro de la empresa, de modo que dos sitios
# nunca colisionen cuando un tecnico esta conectado a ambos a traves de la superposicion de soporte.
# Es una disciplina pequena que evita una clase de fallo real y muy confusa.
# `generador/validar.py` rechaza un octeto repetido o fuera de rango.

octeto: {{ red.octeto }}
dominio_local: {{ red.dominio_local }}
zona_horaria: {{ red.zona_horaria }}

vlans:
  - id: 10
    nombre: Trusted
    subred: "10.{{ red.octeto }}.10.0/24"
    gateway: "10.{{ red.octeto }}.10.1"
    dhcp: true
    rango_dhcp: "10.{{ red.octeto }}.10.100 - 10.{{ red.octeto }}.10.250"
    contenido: Telefonos, portatiles, tabletas e impresoras de la familia
    acceso_internet: completo
    presente: true

  - id: 20
    nombre: IoT
    subred: "10.{{ red.octeto }}.20.0/24"
    gateway: "10.{{ red.octeto }}.20.1"
    dhcp: true
    reservas: true
    rango_dhcp: "10.{{ red.octeto }}.20.100 - 10.{{ red.octeto }}.20.250"
    contenido: Reles Wi-Fi, termostatos, enchufes, paneles tactiles, coordinador Zigbee por Ethernet
    acceso_internet: restringido
    acceso_internet_detalle: >-
      Solo sincronizacion horaria y los puntos concretos de actualizacion que cada fabricante
      requiera. Sin ruta hacia Trusted.
    presente: true

  - id: 30
    nombre: Camera
    subred: "10.{{ red.octeto }}.30.0/24"
    gateway: "10.{{ red.octeto }}.30.1"
    dhcp: false
    reservas_estaticas: true
    contenido: Camaras IP unicamente
    acceso_internet: ninguno
    acceso_internet_detalle: >-
      Sin salida. Las camaras aceptan conexiones del grabador y no originan ninguna. Por eso el
      servidor de hora vive DENTRO de este segmento (ver ntp-camaras.conf) y por eso la
      actualizacion de firmware es tarea manual programada del tecnico, que es argumento del plan de
      cuidado y no un defecto. Las aplicaciones del fabricante NO funcionaran: se le dice al cliente
      durante el diseno, porque es la sorpresa mas comun en la entrega.
    presente: true

  - id: 40
    nombre: Controller
    subred: "10.{{ red.octeto }}.40.0/24"
    gateway: "10.{{ red.octeto }}.40.1"
    dhcp: false
    contenido: Home Assistant y el anfitrion de grabacion
    acceso_internet: restringido
    acceso_internet_detalle: Solo actualizaciones y repositorios de paquetes.
    presente: true
    hosts:
      - ip: "10.{{ red.octeto }}.40.10"
        nombre: controlador
        descripcion: Home Assistant, Mosquitto, Frigate, go2rtc

  - id: 50
    nombre: Management
    subred: "10.{{ red.octeto }}.50.0/24"
    gateway: "10.{{ red.octeto }}.50.1"
    dhcp: false
    contenido: Pasarela, switches, puntos de acceso e interfaces fuera de banda
    acceso_internet: ninguno
    acceso_internet_detalle: Salvo descarga deliberada de firmware por el tecnico.
{% if 50 in paquete_def.vlans.presentes %}
    presente: true
    nota: >-
      Management separada. Se despliega de L en adelante (ADR-009), cuando el numero de equipos de
      red gestionados justifica el segmento propio.
{% else %}
    presente: false
    plegada_en: 10
    nota: >-
      En este nivel (S y M) Management se pliega dentro de TRUSTED, no dentro de Controller
      (ADR-009, enmienda de 2026-08-19). El anfitrion del controlador es el objetivo de mayor valor
      de la instalacion, porque contiene las camaras, y no debe tener alcance administrativo sobre
      la pasarela ni sobre los switches. El acceso administrativo sale del equipo autorizado
      declarado en Trusted, o de una sesion de soporte: la restriccion la aplica el cortafuegos, no
      la existencia de una VLAN separada.
    grupo_de_direcciones: grupo_gestion
    nota_grupo: >-
      Plegar la VLAN NO puede dejar la regla sin destino. Los hosts de gestion se materializan en
      `grupo_gestion`, mas abajo, dentro de la VLAN receptora. Sin ese grupo, la regla
      `controller_a_management` apuntaria a un segmento que no existe y daria cobertura aparente:
      parece que protege y no protege nada.
{% endif %}

  - id: 60
    nombre: Guest
    subred: "10.{{ red.octeto }}.60.0/24"
    gateway: "10.{{ red.octeto }}.60.1"
    dhcp: true
    rango_dhcp: "10.{{ red.octeto }}.60.100 - 10.{{ red.octeto }}.60.250"
    contenido: Visitas
    acceso_internet: completo
    aislamiento_de_clientes: true
{% if 60 in paquete_def.vlans.presentes %}
    presente: true
{% else %}
    presente: false
{% endif %}

# -------------------------------------------------------------------------------------------------
# Reservas estaticas del segmento de camaras
# -------------------------------------------------------------------------------------------------
reservas_camaras:
{% for cam in camaras %}
  - nombre: {{ cam.nombre }}
    ip: "10.{{ red.octeto }}.30.{{ cam.ip_final }}"
    mac: "{{ cam.mac | default('CAMBIAR-EN-COMISIONAMIENTO') }}"
    puerto_switch: "{{ cam.puerto_switch | default('por asignar') }}"
    etiqueta_cable: "{{ cam.etiqueta_cable | default('por asignar') }}"
    clase_poe: "{{ cam.clase_poe | default('802.3at') }}"
{% endfor %}

# -------------------------------------------------------------------------------------------------
# Servidor de hora local del segmento de camaras
# -------------------------------------------------------------------------------------------------
# Una camara con la hora mal produce grabaciones con marca de tiempo equivocada, lo que destruye su
# valor probatorio. Como el segmento no tiene salida, se pone un servidor de hora dentro en lugar de
# abrir una excepcion de salida (cap. 7.4.2).
ntp_camaras:
  servidor: "10.{{ red.octeto }}.30.2"
  fuente_ascendente: controlador

# -------------------------------------------------------------------------------------------------
# Grupo de direcciones de gestion
# -------------------------------------------------------------------------------------------------
# Existe SIEMPRE, este Management separada o plegada, para que las reglas del cortafuegos tengan un
# destino concreto en los dos casos. Cuando la VLAN esta separada, coincide con su subred; cuando
# esta plegada, son direcciones sueltas dentro de la VLAN receptora.
grupo_gestion:
{% if 50 in paquete_def.vlans.presentes %}
  tipo: subred
  subred: "10.{{ red.octeto }}.50.0/24"
  nota: >-
    Management es VLAN propia en este nivel: el grupo es la subred entera.
  miembros:
    - nombre: pasarela
      ip: "10.{{ red.octeto }}.50.1"
    - nombre: switch_principal
      ip: "10.{{ red.octeto }}.50.2"
{# `default(x, true)`: XL declara `puntos_acceso: null` y el default normal no sustituye None. #}
{% set n_ap = paquete_def.red.puntos_acceso_min | default(0, true) or paquete_def.red.puntos_acceso | default(0, true) or 4 %}
{% for i in range(n_ap) %}
    - nombre: punto_acceso_{{ i + 1 }}
      ip: "10.{{ red.octeto }}.50.{{ 10 + i }}"
{% endfor %}
{% else %}
  tipo: direcciones
  vlan_receptora: 10
  nota: >-
    Management plegada en Trusted. Estas son las interfaces de gestion que la regla
    `controller_a_management` tiene que poder nombrar. Se les reserva direccion FIJA en la parte
    baja del rango de Trusted, fuera del rango DHCP, para que el grupo no dependa de una concesion.
  miembros:
    - nombre: pasarela
      ip: "10.{{ red.octeto }}.10.1"
    - nombre: switch_principal
      ip: "10.{{ red.octeto }}.10.2"
{% set n_ap = paquete_def.red.puntos_acceso | default(0, true) or paquete_def.red.puntos_acceso_min | default(0, true) or 1 %}
{% for i in range(n_ap) %}
    - nombre: punto_acceso_{{ i + 1 }}
      ip: "10.{{ red.octeto }}.10.{{ 10 + i }}"
{% endfor %}
    - nombre: interfaz_fuera_de_banda
      ip: "10.{{ red.octeto }}.10.3"
{% endif %}
