# Matriz de cortafuegos - direccional y con estado
# GENERADO. No editar a mano (ADR-006).
#
# Cliente: {{ cliente.nombre }} ({{ cliente.id }})  |  Octeto: {{ red.octeto }}
#
# LA REGLA QUE MAS SE IMPLEMENTA MAL, Y POR QUE IMPORTA:
#
#   La regla de camara es DIRECCIONAL y CON ESTADO. El grabador abre la conexion hacia la camara;
#   la camara no puede abrir una conexion hacia nada. Una regla escrita simplemente como "bloquear
#   la VLAN de camaras" NO es equivalente: o rompe la grabacion, o deja abierta la via de retorno.
#
#   En el documento as-built las reglas se documentan como direccionales. Si el as-built dice
#   "camaras bloqueadas" sin mas, el as-built esta mal.
#
# Politica base: denegar. Lo que no esta permitido explicitamente, no pasa.
#
# =================================================================================================
# DOS RUTAS DISTINTAS, Y UNA REGLA EN LA RUTA EQUIVOCADA NO PROTEGE
# =================================================================================================
#
# Este archivo tiene DOS listas, y la diferencia no es organizativa:
#
#   `reglas`         RUTA DE REENVIO. Trafico que ATRAVIESA la pasarela para ir de un segmento a
#                    otro. Es donde viven las reglas entre VLAN.
#
#   `reglas_entrada` RUTA DE ENTRADA. Trafico DIRIGIDO A LA PASARELA MISMA: su interfaz de
#                    administracion, SSH, SNMP, el portal de gestion.
#
# El trafico dirigido a la pasarela **no se reenvia**: termina en ella. Por eso se filtra en una
# ruta distinta, que las reglas de reenvio NO TOCAN. UniFi, Omada y MikroTik se comportan asi.
#
# Consecuencia practica, y es la que costo encontrar: una regla de reenvio con destino la IP de la
# pasarela **no bloquea nada**. Parece que protege el acceso administrativo y no lo toca.
#
# Y hay un segundo detalle del mismo tipo: **la pasarela tiene una interfaz en CADA VLAN que
# sirve**, y todas responden a la misma administracion. Denegar el acceso a `10.<octeto>.10.1` no
# impide llegar a `10.<octeto>.40.1`, que desde el controlador es literalmente su propia puerta de
# enlace. Por eso `grupo_gestion` de vlans.yaml enumera la pasarela en todas las VLAN presentes.
#
# REGLA GENERAL: una regla protege cuando su destino resuelve a direcciones concretas Y esta en la
# ruta por la que el trafico pasa de verdad. Lo primero sin lo segundo es cobertura aparente.
#
# NOTA SOBRE MANAGEMENT (ADR-009, enmienda de 2026-08-19): en los niveles S y M la VLAN 50 esta
# plegada dentro de TRUSTED (10), no dentro de Controller.
#
# Por que Trusted y no Controller: el anfitrion del controlador es el objetivo de mayor valor de la
# instalacion, porque contiene las camaras y su grabacion. Plegar la gestion de red dentro de su
# segmento le daba alcance administrativo sobre la pasarela, los switches y los puntos de acceso.
# Comprometer el grabador pasaba a significar comprometer la infraestructura de red entera.
#
# Las reglas que nombran Management SIGUEN APLICANDOSE: se aplican sobre las interfaces de gestion,
# que en esos niveles viven en el segmento Trusted y solo son alcanzables desde el equipo
# administrativo declarado. Plegar la VLAN reduce el numero de segmentos que mantener en una
# instalacion pequena; no relaja la politica.
#
# REGLA QUE NO DEPENDE DEL NIVEL: **Controller nunca alcanza las interfaces de gestion.** Ni
# plegada ni separada, ni en S ni en XL. Es la regla `controller_a_management` de mas abajo y tiene
# prueba propia.
#
# CONSECUENCIA DE PLEGAR, y es la parte que se olvida: cuando Management no es VLAN propia, el
# destino de esa regla NO PUEDE SER EL NOMBRE DEL SEGMENTO, porque el segmento no existe. Apuntaria
# a nada y la regla daria cobertura aparente: parece que protege y no protege. Por eso vlans.yaml
# materializa `grupo_gestion` con las interfaces de gestion una por una, y esta regla apunta ahi.
# Lo que de hecho protegia antes en S y M era `controller_a_trusted: denegar`, que es una regla
# distinta y que alguien podria relajar sin darse cuenta de lo que se lleva por delante.
#
# Matriz de origen a destino (cap. 7.4.1):
#
#   Desde \ Hacia | Trusted | IoT      | Camera | Controller | Management
#   Trusted       |   -     | permitir | DENY   | permitir   | denegar por defecto
#   IoT           | DENY    |    -     | DENY   | permitir   | DENY
#   Camera        | DENY    | DENY     |   -    | DENY       | DENY
#   Controller    | DENY    | permitir | permitir |    -     | denegar por defecto
#   Guest         | DENY    | DENY     | DENY   | DENY       | DENY

{# Las VLAN que este paquete despliega. La pasarela tiene una interfaz en cada una, y todas
   responden a la misma administracion: por eso las reglas de entrada las enumeran todas. #}
{% set VLANS = [
     {'id': 10, 'nombre': 'Trusted'},
     {'id': 20, 'nombre': 'IoT'},
     {'id': 30, 'nombre': 'Camera'},
     {'id': 40, 'nombre': 'Controller'},
     {'id': 50, 'nombre': 'Management'},
     {'id': 60, 'nombre': 'Guest'},
   ] %}
{% set vlans_presentes = VLANS | selectattr('id', 'in', paquete_def.vlans.presentes) | list %}

politica_por_defecto: denegar
inspeccion_con_estado: true

reglas:

  # -----------------------------------------------------------------------------------------------
  # Trusted
  # -----------------------------------------------------------------------------------------------
  - id: trusted_a_controller_ui
    descripcion: La familia accede a la interfaz del sistema.
    origen: Trusted
    destino: Controller
    destino_host: "10.{{ red.octeto }}.40.10"
    puertos: [443, 8123]
    protocolo: tcp
    accion: permitir
    con_estado: true

  - id: trusted_a_iot_control
    descripcion: >-
      Control directo de dispositivos IoT concretos desde la red de la familia, solo donde el diseno
      lo requiera. No es un permiso general de Trusted hacia IoT.
    origen: Trusted
    destino: IoT
    puertos: {{ red.puertos_trusted_a_iot | default([80, 443]) }}
    protocolo: tcp
    accion: permitir
    con_estado: true

  - id: trusted_a_camera
    descripcion: >-
      La familia NO habla con las camaras directamente. Todo el video se ve por la interfaz del
      sistema, que es la unica que abre conexion contra la camara.
    origen: Trusted
    destino: Camera
    accion: denegar

  - id: trusted_a_management
    descripcion: >-
      Gestion accesible solo desde un equipo administrativo declarado o desde una sesion de soporte
      autorizada, nunca desde cualquier equipo de la familia.
    origen: Trusted
    destino: Management
    accion: denegar
    excepcion_host: "{{ red.equipo_administrativo | default('ninguno declarado') }}"

  # -----------------------------------------------------------------------------------------------
  # IoT
  # -----------------------------------------------------------------------------------------------
  - id: iot_a_controller_mqtt
    descripcion: Los dispositivos IoT publican en el broker MQTT del controlador.
    origen: IoT
    destino: Controller
    destino_host: "10.{{ red.octeto }}.40.10"
    puertos: [1883]
    protocolo: tcp
    accion: permitir
    con_estado: true

  - id: iot_a_trusted
    descripcion: Un dispositivo IoT comprometido no debe alcanzar los equipos personales del hogar.
    origen: IoT
    destino: Trusted
    accion: denegar

  - id: iot_a_camera
    origen: IoT
    destino: Camera
    accion: denegar

  - id: iot_a_management
    origen: IoT
    destino: Management
    accion: denegar

  - id: iot_a_internet
    descripcion: >-
      Salida restringida: sincronizacion horaria y los puntos de actualizacion concretos que cada
      fabricante requiera. Se enumeran en el as-built; no hay salida general.
    origen: IoT
    destino: internet
    puertos: [123]
    protocolo: udp
    accion: permitir
    con_estado: true

  # -----------------------------------------------------------------------------------------------
  # Camera - el segmento mas restringido de la instalacion
  # -----------------------------------------------------------------------------------------------
  - id: camera_no_origina_nada
    descripcion: >-
      REGLA CENTRAL. La camara no origina ninguna conexion, hacia ningun destino, incluido internet.
      Solo responde a la sesion que abre el grabador. Con esto, una camara comprometida no puede
      llamar a casa, no puede escanear la red y no puede exfiltrar video.
    origen: Camera
    destino: cualquiera
    accion: denegar

  - id: controller_a_camera_rtsp
    descripcion: El grabador abre la conexion hacia la camara. Esta es la unica direccion permitida.
    origen: Controller
    origen_host: "10.{{ red.octeto }}.40.10"
    destino: Camera
    puertos: [554, 80, 443, 8000]
    protocolo: tcp
    accion: permitir
    con_estado: true

  - id: ntp_local_camaras
    descripcion: >-
      Servidor de hora dentro del propio segmento. Evita abrir una excepcion de salida solo para
      sincronizar el reloj, y sin reloj correcto la grabacion pierde valor probatorio.
    origen: Camera
    destino: Camera
    destino_host: "10.{{ red.octeto }}.30.2"
    puertos: [123]
    protocolo: udp
    accion: permitir
    con_estado: true

  # -----------------------------------------------------------------------------------------------
  # Controller
  # -----------------------------------------------------------------------------------------------
  - id: controller_a_iot
    descripcion: El controlador manda a los dispositivos IoT.
    origen: Controller
    destino: IoT
    accion: permitir
    con_estado: true

  - id: controller_a_trusted
    descripcion: >-
      El controlador no inicia conexiones hacia los equipos personales. Las notificaciones salen por
      el canal correspondiente, no por conexion directa a un telefono.
    origen: Controller
    destino: Trusted
    accion: denegar

  - id: controller_a_management
    descripcion: >-
      REGLA QUE NO DEPENDE DEL NIVEL. El controlador NUNCA alcanza las interfaces de gestion, este
      Management como VLAN separada o plegada, y sea cual sea el paquete. El anfitrion del
      controlador es el objetivo de mayor valor de la instalacion porque contiene las camaras y su
      grabacion: darle alcance administrativo sobre la pasarela y los switches convertiria un
      compromiso del grabador en un compromiso de la red entera. La gestion se hace desde el equipo
      administrativo declarado o desde una sesion de soporte, nunca desde el propio controlador.
    ruta: reenvio
    nota_ruta: >-
      Esta regla vive en la ruta de REENVIO y cubre el trafico que atraviesa la pasarela hacia el
      equipo gestionado: switches, puntos de acceso, interfaz fuera de banda. NO cubre el acceso a
      la administracion de la pasarela misma, que termina en ella y se filtra en la ruta de entrada.
      Su companera obligatoria es `entrada_admin_pasarela`, mas abajo. Las dos, o ninguna protege.
    origen: Controller
{% if 50 in paquete_def.vlans.presentes %}
    destino: Management
    destino_subred: "10.{{ red.octeto }}.50.0/24"
    # La subred cubre el equipo gestionado de Management. Las interfaces de la pasarela en las OTRAS
    # VLAN no se reenvian: las cubre `entrada_admin_pasarela`.
{% else %}
    # Management esta plegada en Trusted. El destino NO puede ser el nombre de un segmento que no
    # existe: apuntaria a nada y la regla daria cobertura aparente. Se apunta al grupo de
    # direcciones materializado en vlans.yaml, que enumera las interfaces de gestion una por una.
    destino: grupo_gestion
    # Equipo gestionado que SI se alcanza por reenvio: switch, interfaz fuera de banda y puntos de
    # acceso. Las interfaces de la pasarela NO estan aqui a proposito: no se reenvia hacia ellas,
    # terminan en el router, y las cubre `entrada_admin_pasarela` en la ruta de entrada. Entre las
    # dos reglas cubren `grupo_gestion` entero, y hay una prueba que lo comprueba.
    destino_direcciones:
      - "10.{{ red.octeto }}.10.2"    # switch principal
      - "10.{{ red.octeto }}.10.3"    # interfaz fuera de banda
{% set n_ap = paquete_def.red.puntos_acceso | default(0, true) or paquete_def.red.puntos_acceso_min | default(0, true) or 1 %}
{% for i in range(n_ap) %}
      - "10.{{ red.octeto }}.10.{{ 10 + i }}"   # punto de acceso {{ i + 1 }}
{% endfor %}
{% endif %}
    accion: denegar

  - id: controller_a_internet
    descripcion: Solo actualizaciones y repositorios de paquetes.
    origen: Controller
    destino: internet
    puertos: [80, 443, 123]
    protocolo: tcp_udp
    accion: permitir
    con_estado: true

  # -----------------------------------------------------------------------------------------------
  # Guest
  # -----------------------------------------------------------------------------------------------
  - id: guest_aislado
    descripcion: Internet y nada mas. Aislamiento de clientes activado dentro del propio segmento.
    origen: Guest
    destino: [Trusted, IoT, Camera, Controller, Management]
    accion: denegar

  - id: guest_a_internet
    origen: Guest
    destino: internet
    accion: permitir
    con_estado: true

  # -----------------------------------------------------------------------------------------------
  # Perimetro
  # -----------------------------------------------------------------------------------------------
  - id: sin_entrantes
    descripcion: >-
      NINGUN puerto abierto hacia internet. Sin reenvio de puertos, sin UPnP, sin gestion remota de
      la pasarela. El acceso remoto entra por el tunel WireGuard, que se establece desde dentro.
      Se comprueba con escaneo externo en la puesta en servicio y el resultado limpio se adjunta al
      acta de aceptacion.
    origen: internet
    destino: cualquiera
    accion: denegar

  # ---------------------------------------------------------------------------------------------
  # Roles de flujo de camara sobre el tunel (ADR-012)
  # ---------------------------------------------------------------------------------------------
  # principal  grabacion local. NO se sirve por el tunel salvo peticion explicita del cliente, y
  #            con advertencia: satura la subida y se interpreta como averia del sistema
  # medio      apertura de UNA camara en remoto
  # sub        deteccion y cuadricula remota
  #
  # No se transcodifica en el servidor para fabricar un flujo que la camara no publique: el equipo
  # es clase N100 y el transcodificado consume el presupuesto de inferencia de la deteccion.
  - id: politica_de_flujos_por_tunel
    descripcion: >-
      Por defecto, el tunel sirve `sub` para la cuadricula y `medio` al abrir una camara. El
      `principal` solo se sirve a peticion explicita, y la interfaz advierte antes de servirlo.
    origen: tunel
    destino: Controller
    flujo_por_defecto: sub
    flujo_de_apertura: medio
    flujo_principal_bajo_demanda: true
    accion: permitir
    con_estado: true

  - id: tunel_wireguard
    descripcion: >-
      El telefono del cliente establece un tunel cifrado directo contra su propio controlador. Donde
      la traduccion de direcciones simetrica lo impide, la conexion cae a un relevo cifrado que NO
      puede descifrar el trafico que pasa por el. Las claves pertenecen al cliente.
    origen: tunel
    destino: Controller
    destino_host: "10.{{ red.octeto }}.40.10"
    puertos: [443, 8123]
    protocolo: tcp
    accion: permitir
    con_estado: true

  - id: tunel_soporte
    descripcion: >-
      Acceso de soporte de la empresa. NO existe de forma permanente: lo crea el cliente desde su
      panel y expira solo (plantillas/homeassistant/packages/sistema.yaml.j2). Esta regla describe
      lo que la autorizacion temporal habilita mientras esta viva.
    origen: tunel_soporte
    destino: [Controller, Management]
    accion: permitir_temporal
    duracion_horas: {{ soporte.duracion_horas | default(2) }}
    con_estado: true

# =================================================================================================
# REGLAS DE ENTRADA
# =================================================================================================
# Trafico DIRIGIDO A LA PASARELA MISMA. No se reenvia: termina en ella, y se filtra en esta ruta,
# que las reglas de arriba no tocan.
#
# Esta seccion existe porque sin ella la proteccion del acceso administrativo era aparente. La regla
# de reenvio `controller_a_management` cubre el camino hacia switches y puntos de acceso; el acceso
# a la administracion del propio router nunca paso por ahi.

politica_entrada_por_defecto: denegar

reglas_entrada:

  - id: entrada_admin_pasarela
    descripcion: >-
      NINGUN segmento alcanza los servicios de administracion de la pasarela. La excepcion es
      Management cuando existe como VLAN propia, y el equipo administrativo declarado en Trusted
      cuando Management esta plegada. Se aplica a TODAS las interfaces de la pasarela, no solo a
      una: tiene una en cada VLAN que sirve y todas responden a la misma administracion.
    ruta: entrada
    destino: interfaces_de_la_pasarela
    destino_direcciones:
{% for v in vlans_presentes %}
      - "10.{{ red.octeto }}.{{ v.id }}.1"    # {{ v.nombre }}
{% endfor %}
    puertos_administracion: [22, 80, 443, 8443, 161]
    protocolo: tcp_udp
    origenes_denegados:
      - Controller
      - IoT
      - Camera
{% if 60 in paquete_def.vlans.presentes %}
      - Guest
{% endif %}
    accion: denegar

  - id: entrada_admin_pasarela_permitida
    descripcion: >-
      Unica via de administracion de la pasarela.
{% if 50 in paquete_def.vlans.presentes %}
      Management es VLAN propia: la administracion se hace desde ella.
{% else %}
      Management esta plegada: la administracion se hace SOLO desde el equipo administrativo
      declarado en `red.equipo_administrativo`, no desde cualquier equipo de Trusted. Si ese campo
      esta sin declarar, no hay via permitida y la administracion se hace por consola fisica, que es
      el estado correcto mientras nadie decida lo contrario.
{% endif %}
    ruta: entrada
    destino: interfaces_de_la_pasarela
    puertos_administracion: [22, 443, 8443]
    protocolo: tcp
{% if 50 in paquete_def.vlans.presentes %}
    origen_permitido: Management
    origen_subred: "10.{{ red.octeto }}.50.0/24"
{% else %}
    origen_permitido: equipo_administrativo
    origen_direccion: "{{ red.equipo_administrativo | default('ninguno declarado', true) }}"
{% endif %}
    accion: permitir
    con_estado: true

  - id: entrada_dns_dhcp
    descripcion: >-
      La pasarela sigue sirviendo DNS y DHCP a los segmentos que lo necesitan. Son servicios de red,
      no administracion, y bloquearlos por error deja la instalacion sin resolver nombres. Se
      declaran aparte para que nadie los meta en la regla de administracion ni al reves.
    ruta: entrada
    destino: interfaces_de_la_pasarela
    puertos: [53, 67]
    protocolo: tcp_udp
    origenes_permitidos:
      - Trusted
      - IoT
      - Controller
{% if 60 in paquete_def.vlans.presentes %}
      - Guest
{% endif %}
    accion: permitir
    con_estado: true
    nota: >-
      Camera NO esta en la lista: su segmento no tiene salida y su hora la sirve el servidor local
      del propio segmento (cap. 7.4.2). Si una camara pidiera DNS, es que algo esta mal configurado.

  - id: entrada_sin_administracion_desde_internet
    descripcion: >-
      Gestion remota de la pasarela desde internet, deshabilitada. Es el punto 7 del checklist de
      endurecimiento y se comprueba con el escaneo externo de la puesta en servicio.
    ruta: entrada
    origen: internet
    destino: interfaces_de_la_pasarela
    accion: denegar

# -------------------------------------------------------------------------------------------------
# Comprobacion en obra
# -------------------------------------------------------------------------------------------------
# Desde el anfitrion del controlador, intentar abrir la administracion de la pasarela por CADA una
# de sus direcciones. El resultado esperado es FALLO EN TODAS, no solo en la primera:
#
{% for v in vlans_presentes %}
#   curl -sS --max-time 5 https://10.{{ red.octeto }}.{{ v.id }}.1/    # {{ v.nombre }}  -> debe fallar
{% endfor %}
#
# Consta como prueba del acta de aceptacion. Probar solo una direccion es exactamente el error que
# esta seccion corrige.
